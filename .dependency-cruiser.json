{
  "$schema": "https://www.dependency-cruiser.org/schema/dependency-cruiser-config.json",
  "forbidden": [
    {
      "name": "no-cycles",
      "severity": "error",
      "from": {},
      "to": {
        "circular": true
      }
    },
    {
      "name": "no-unresolved-imports",
      "severity": "error",
      "from": {},
      "to": {
        "couldNotResolve": true
      }
    },
    {
      "name": "entrypoints-are-composition-only",
      "severity": "error",
      "from": {
        "path": "^(src|aggregator)/"
      },
      "to": {
        "path": "^entrypoints/"
      }
    },
    {
      "name": "extension-independent-of-dashboard",
      "severity": "error",
      "from": {
        "path": "^(src|entrypoints)/"
      },
      "to": {
        "path": "^aggregator/"
      }
    },
    {
      "name": "aggregator-metadata-only",
      "severity": "error",
      "from": {
        "path": "^aggregator/"
      },
      "to": {
        "path": "^src/(?!domain/(?:errors|types|url|article)\\.ts$|directory/)"
      }
    },
    {
      "name": "domain-independent",
      "severity": "error",
      "from": {
        "path": "^src/domain/"
      },
      "to": {
        "path": "^src/(?!(?:domain)/)"
      }
    },
    {
      "name": "application-imports",
      "severity": "error",
      "from": {
        "path": "^src/application/"
      },
      "to": {
        "path": "^src/(?!(?:application|domain)/)"
      }
    },
    {
      "name": "storage-imports",
      "severity": "error",
      "from": {
        "path": "^src/storage/"
      },
      "to": {
        "path": "^src/(?!(?:storage|domain)/)"
      }
    },
    {
      "name": "directory-imports",
      "severity": "error",
      "from": {
        "path": "^src/directory/"
      },
      "to": {
        "path": "^src/(?!(?:directory|domain)/)"
      }
    },
    {
      "name": "transport-imports",
      "severity": "error",
      "from": {
        "path": "^src/transport/"
      },
      "to": {
        "path": "^src/(?!(?:transport|directory|domain)/)"
      }
    },
    {
      "name": "extraction-imports",
      "severity": "error",
      "from": {
        "path": "^src/extraction/"
      },
      "to": {
        "path": "^src/(?!(?:extraction|domain)/)"
      }
    },
    {
      "name": "pages-imports",
      "severity": "error",
      "from": {
        "path": "^src/pages/"
      },
      "to": {
        "path": "^src/(?!(?:pages|domain)/|extraction/sanitize\\.ts$)"
      }
    },
    {
      "name": "platform-imports",
      "severity": "error",
      "from": {
        "path": "^src/platform/"
      },
      "to": {
        "path": "^src/(?!(?:platform|domain|extraction)/)"
      }
    },
    {
      "name": "browser-no-node",
      "severity": "error",
      "from": {
        "path": "^(src|entrypoints)/"
      },
      "to": {
        "dependencyTypes": [
          "core"
        ]
      }
    },
    {
      "name": "readability-only-extraction",
      "severity": "error",
      "from": {
        "path": "^(src|entrypoints|aggregator)/",
        "pathNot": "^src/extraction/"
      },
      "to": {
        "path": "(^|/)node_modules/.*@mozilla/readability"
      }
    },
    {
      "name": "websocket-node-adapter-only",
      "severity": "error",
      "from": {
        "path": "^(src|entrypoints|aggregator)/",
        "pathNot": "^aggregator/main\\.ts$"
      },
      "to": {
        "path": "^node_modules/ws(?:/|$)"
      }
    },
    {
      "name": "no-retired-experiments",
      "severity": "error",
      "from": {},
      "to": {
        "path": "(^|/)(spikes|research)/"
      }
    },
    {
      "name": "runtime-no-dev-dependencies",
      "severity": "error",
      "from": {
        "path": "^(src|entrypoints|aggregator)/"
      },
      "to": {
        "dependencyTypes": [
          "npm-dev"
        ]
      }
    }
  ],
  "options": {
    "doNotFollow": {
      "path": "node_modules"
    },
    "tsConfig": {
      "fileName": "tsconfig.json"
    },
    "tsPreCompilationDeps": true,
    "exclude": "(^|/)(node_modules|\\.output|\\.wxt|artifacts)/",
    "enhancedResolveOptions": {
      "exportsFields": [
        "exports"
      ],
      "conditionNames": [
        "import",
        "default"
      ],
      "mainFields": [
        "module",
        "main"
      ]
    }
  }
}
