{
  "name": "emberpage",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Explicit article caching with Blossom files and Nostr discovery.",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.*",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm verify:release",
    "verify:release": "node scripts/verify-release.mjs",
    "smoke": "node scripts/smoke.mjs",
    "aggregator": "tsx aggregator/main.ts",
    "smoke:aggregator": "tsx scripts/smoke-aggregator.mjs",
    "test:drive": "RUN_TEST_DRIVES=1 node scripts/test-drive.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "effect": "^4.0.2",
    "nostr-tools": "^2.25.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.0",
    "jsdom": "^27.0.0",
    "playwright": "^1.56.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wxt": "^0.21.4"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/emberpage/emberpage.git"
  }
}
