{
  "name": "emberpage",
  "version": "0.1.10",
  "private": true,
  "type": "module",
  "description": "Preserve readable article snapshots for when links break or pages disappear.",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:effect && pnpm scan && pnpm test && pnpm build && pnpm verify:release",
    "verify:release": "tsx scripts/verify-release.ts",
    "smoke": "tsx scripts/smoke.ts",
    "aggregator": "tsx aggregator/main.ts",
    "smoke:aggregator": "tsx scripts/smoke-aggregator.ts",
    "test:drive": "RUN_TEST_DRIVES=1 tsx scripts/test-drive.ts",
    "lint": "eslint . --max-warnings 0",
    "scan": "knip && depcruise src entrypoints aggregator --config .dependency-cruiser.json && tsx scripts/check-repo.ts",
    "smoke:images": "SMOKE_SCREENSHOT_PERMISSION=1 tsx scripts/smoke-images.ts",
    "lint:effect": "effect-language-service diagnostics --project tsconfig.json --strict --format github-actions"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "effect": "^4.0.2",
    "esbuild": "^0.28.2",
    "nostr-tools": "^2.25.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.4",
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "fake-indexeddb": "^6.2.0",
    "jiti": "^2.7.0",
    "jsdom": "^27.0.0",
    "knip": "^6.41.0",
    "playwright": "^1.56.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "wxt": "^0.21.4"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/emberpage/emberpage.git"
  }
}
