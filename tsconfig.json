{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "allowJs": false,
    "noEmit": true,
    "types": [
      "chrome",
      "node"
    ],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "anyUnknownInErrorContext": "error",
          "unsafeEffectTypeAssertion": "error",
          "strictEffectProvide": "error",
          "leakingRequirements": "error"
        }
      }
    ]
  },
  "include": [
    "*.ts",
    "*.tsx",
    "*.mts",
    "*.cts",
    "src/**/*",
    "entrypoints/**/*",
    "aggregator/**/*",
    "scripts/**/*",
    "tests/**/*",
    ".wxt/wxt.d.ts"
  ],
  "exclude": [
    "node_modules",
    ".output",
    "artifacts"
  ]
}
